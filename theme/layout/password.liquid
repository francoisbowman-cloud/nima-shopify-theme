<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- style -%}
      :root{
        --bg: {{ settings.color_bg }}; --text: {{ settings.color_text }};
        --muted: {{ settings.color_muted }}; --line: {{ settings.color_line }};
        --soft: {{ settings.color_soft }}; --green: {{ settings.color_accent }};
        --green2: {{ settings.color_accent_soft }};
        --page-width: {{ settings.page_width }}px;
        {%- if settings.heading_font != blank -%}
          --serif: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
        {%- endif -%}
        {%- if settings.body_font != blank -%}
          --sans: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
        {%- endif -%}
      }
      {%- if settings.body_font != blank -%}{{ settings.body_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if settings.heading_font != blank -%}{{ settings.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
