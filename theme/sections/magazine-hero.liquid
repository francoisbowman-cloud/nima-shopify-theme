<section class="container mag-hero{% if section.settings.image != blank %} mag-hero--image{% endif %}">
  {%- if section.settings.image != blank -%}
    {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading | strip_html -%}
    {{
      section.settings.image
      | image_url: width: 1800
      | image_tag:
        widths: '640, 960, 1200, 1600, 1800',
        sizes: '(min-width: 1180px) 1180px, 100vw',
        loading: 'eager',
        fetchpriority: 'high',
        decoding: 'async',
        class: 'mag-hero__media',
        alt: hero_alt
    }}
    <span class="mag-media-scrim" aria-hidden="true"></span>
  {%- endif -%}
  <div class="mag-hero__content">
    {%- if section.settings.kicker != blank -%}<span class="kicker{% if section.settings.image != blank %} on-dark-kicker{% endif %}">{{ section.settings.kicker }}</span>{%- endif -%}
    <h1{% if section.settings.image != blank %} class="on-dark-heading"{% endif %}>{{ section.settings.heading }}</h1>
  </div>
</section>

{% schema %}
{
  "name": "Magazine — Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "OVL Edition 01" },
    { "type": "html", "id": "heading", "label": "Título (permite <br>)", "default": "Viajar<br>sin ansiedad." }
  ],
  "presets": [{ "name": "Magazine — Hero" }]
}
{% endschema %}
