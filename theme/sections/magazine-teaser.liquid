<div class="container">
  <section class="mag-teaser">
    {%- if section.settings.image != blank -%}
      <img class="mag-teaser__img" src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" loading="lazy">
    {%- endif -%}
    <div class="mag-teaser__scrim"></div>
    <div class="mag-teaser__card">
      <span class="kicker" style="color:#EDE0D0">{{ section.settings.kicker }}</span>
      <h3 class="mag-teaser__h">{{ section.settings.heading }}</h3>
      <p style="color:rgba(251,248,243,0.8)">{{ section.settings.text }}</p>
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--light" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Teaser de Magazine",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de fondo" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Nima Magazine" },
    { "type": "text", "id": "heading", "label": "Título", "default": "El ritual del baño: por qué el grooming es un momento de calma." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Historias sobre el cuidado diario — de comederos a siestas largas." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Leer la historia completa" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Teaser de Magazine" }]
}
{% endschema %}
