{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign main_image = current_variant.featured_image | default: product.featured_image
  assign color_option_index = -1
  for opt in product.options_with_values
    if opt.name == 'Color'
      assign color_option_index = forloop.index0
    endif
  endfor
-%}

<section class="product product--b">
  <div class="gallery gallery--b">
    <div class="gallery__main">
      {%- if main_image != blank -%}
        {%- assign main_alt = main_image.alt | default: product.title -%}
        <img
          data-gallery-main
          src="{{ main_image | image_url: width: 1200 }}"
          srcset="
            {{ main_image | image_url: width: 480 }} 480w,
            {{ main_image | image_url: width: 720 }} 720w,
            {{ main_image | image_url: width: 960 }} 960w,
            {{ main_image | image_url: width: 1200 }} 1200w,
            {{ main_image | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 801px) 60vw, 100vw"
          alt="{{ main_alt | escape }}"
          width="{{ main_image.width }}"
          height="{{ main_image.height }}"
          loading="eager"
          fetchpriority="high"
          decoding="async">
      {%- else -%}
        <div class="product-media-placeholder" role="img" aria-label="{{ 'products.image_unavailable_for' | t: product: product.title | escape }}">
          <svg aria-hidden="true" viewBox="0 0 48 48" focusable="false">
            <rect x="7" y="9" width="34" height="30" rx="3"></rect>
            <path d="m12 33 8-8 6 6 4-4 6 6"></path>
            <circle cx="31" cy="18" r="3"></circle>
          </svg>
          <span>{{ 'products.image_unavailable' | t }}</span>
        </div>
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="gallery__thumbs gallery__thumbs--b">
        {%- for image in product.images limit: 8 -%}
          {%- assign thumb_alt = image.alt | default: product.title -%}
          <button
            type="button"
            data-gallery-thumb
            data-full="{{ image | image_url: width: 1600 }}"
            data-full-alt="{{ thumb_alt | escape }}"
            data-full-width="{{ image.width }}"
            data-full-height="{{ image.height }}"
            aria-label="{{ 'products.view_image' | t: index: forloop.index }}"
            aria-pressed="{% if image.id == main_image.id %}true{% else %}false{% endif %}">
            {{
              image
              | image_url: width: 300
              | image_tag:
                widths: '96, 150, 200, 300',
                sizes: '96px',
                loading: 'lazy',
                decoding: 'async',
                alt: thumb_alt
            }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="buy">
    {%- if product.type != blank -%}
      <span class="kicker">{% render 'product-type-label', type: product.type %}</span>
    {%- endif -%}

    <h1>{{ product.title }}</h1>

    {%- assign functional_benefit = product.metafields.ovl.functional_benefit -%}
    {%- if functional_benefit != blank -%}
      <p class="product-benefit">{{ functional_benefit }}</p>
    {%- endif -%}

    <div class="price{% if current_variant.compare_at_price > current_variant.price %} price--sale{% endif %}">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <s>{{ current_variant.compare_at_price | money }}</s>
      {%- endif -%}
      <span data-price>{{ current_variant.price | money }}</span>
    </div>

    <p class="product-availability{% unless current_variant.available %} product-availability--unavailable{% endunless %}" data-availability>
      {%- if current_variant.available -%}{{ 'products.in_stock' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
    </p>

    {%- assign e1 = product.metafields.ovl.dominant_emotion -%}
    {%- assign e2 = product.metafields.ovl.emotional_benefit -%}
    {%- if e1 != blank or e2 != blank -%}
      <div class="badge-row">
        {%- if e1 != blank -%}<span class="badge-pill">{{ e1 }}</span>{%- endif -%}
        {%- if e2 != blank -%}<span class="badge-pill">{{ e2 }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.highlights != blank -%}
      <p class="muted">{{ section.settings.highlights }}</p>
    {%- endif -%}

    {% form 'product', product, data-product-form: 'true' %}
      {%- unless product.has_only_default_variant -%}
        {%- if color_option_index > -1 and product.options.size == 1 -%}
          <div class="swatch-label">{{ 'products.color' | t }}</div>
          <div class="swatches" role="radiogroup" aria-label="{{ 'products.color' | t }}">
            {%- for variant in product.variants -%}
              {%- liquid
                assign color_name = variant.options[color_option_index] | downcase
                case color_name
                  when 'crema' or 'beige' or 'cream'
                    assign hex = '#F3ECE1'
                  when 'terracota' or 'brown' or 'marron'
                    assign hex = '#8A5A3B'
                  when 'carbón' or 'carbon' or 'black' or 'negro'
                    assign hex = '#2B2621'
                  when 'blue' or 'azul'
                    assign hex = '#5B7C99'
                  when 'pink' or 'rosa'
                    assign hex = '#D89AA6'
                  when 'grey' or 'gray' or 'gris'
                    assign hex = '#A9A29A'
                  when 'green' or 'verde'
                    assign hex = '#6B8E63'
                  when 'red' or 'rojo'
                    assign hex = '#A6493D'
                  when 'white' or 'blanco'
                    assign hex = '#FBF8F3'
                  else
                    assign hex = '#E7DFD2'
                endcase
              -%}
              <label class="swatch{% if variant.id == current_variant.id %} swatch--active{% endif %}" style="background:{{ hex }}" title="{{ variant.options[color_option_index] }}">
                <input
                  id="Variant-{{ section.id }}-{{ variant.id }}"
                  type="radio"
                  name="variant_selector"
                  value="{{ variant.id }}"
                  data-variant-option
                  data-price="{{ variant.price | money | escape }}"
                  data-available="{{ variant.available }}"
                  data-image="{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1600 }}{% endif %}"
                  data-image-alt="{{ variant.featured_image.alt | default: product.title | escape }}"
                  {% if variant.id == current_variant.id %}checked{% endif %}
                  {% unless variant.available %}disabled{% endunless %}
                  class="visually-hidden">
                <span class="visually-hidden">{{ variant.options[color_option_index] }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}</span>
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="options" role="radiogroup" aria-label="{{ 'products.variants' | t }}">
            {%- for variant in product.variants -%}
              <label class="option{% if variant.id == current_variant.id %} active{% endif %}">
                <input
                  id="Variant-{{ section.id }}-{{ variant.id }}"
                  type="radio"
                  name="variant_selector"
                  value="{{ variant.id }}"
                  data-variant-option
                  data-price="{{ variant.price | money | escape }}"
                  data-available="{{ variant.available }}"
                  data-image="{% if variant.featured_image != blank %}{{ variant.featured_image | image_url: width: 1600 }}{% endif %}"
                  data-image-alt="{{ variant.featured_image.alt | default: product.title | escape }}"
                  {% if variant.id == current_variant.id %}checked{% endif %}
                  {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endunless -%}

      <input type="hidden" name="id" value="{{ current_variant.id }}">

      <button
        type="submit"
        class="add"
        data-add-btn
        data-adding="{{ 'products.adding' | t }}"
        data-added="{{ 'products.added' | t }}"
        data-add-label="{{ 'products.add_to_cart' | t }}"
        data-available-label="{{ 'products.in_stock' | t }}"
        data-soldout-label="{{ 'products.sold_out' | t }}"
        {% unless current_variant.available %}disabled{% endunless %}>
        {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }} — {{ current_variant.price | money }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
      </button>
      <p class="product-form-error" data-product-error role="alert" hidden>{{ 'products.add_error' | t }}</p>
    {% endform %}

    {%- liquid
      assign delivery_note = section.settings.delivery_note
      assign returns_note = section.settings.returns_note
      if delivery_note == blank
        assign delivery_note = 'products.shipping_us' | t
      endif
      if returns_note == blank
        assign returns_note = 'products.returns_30_days' | t
      endif
    -%}
    <div class="trust trust--center">
      {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ delivery_note }}</a>{%- else -%}<span>{{ delivery_note }}</span>{%- endif -%}
      {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">{{ returns_note }}</a>{%- else -%}<span>{{ returns_note }}</span>{%- endif -%}
    </div>

    {%- if product.description != blank -%}
      <details class="product-details">
        <summary>{{ 'products.details' | t }}</summary>
        <div class="rte">{{ product.description }}</div>
      </details>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.banner_text != blank -%}
<div class="product-banner">
  <p>{{ section.settings.banner_text }}</p>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Producto — Compra rápida",
  "settings": [
    { "type": "text", "id": "highlights", "label": "Bullets / destacados" },
    { "type": "text", "id": "delivery_note", "label": "Nota de entrega" },
    { "type": "text", "id": "returns_note", "label": "Nota de devolución" },
    { "type": "text", "id": "banner_text", "label": "Frase banner (opcional, itálica, debajo de compra)" }
  ]
}
{% endschema %}
