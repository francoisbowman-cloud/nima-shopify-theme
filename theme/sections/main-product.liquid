{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign color_option_index = -1
  for opt in product.options_with_values
    if opt.name == 'Color'
      assign color_option_index = forloop.index0
    endif
  endfor
-%}

<section class="product product--b">
  <div class="gallery gallery--b">
    <div class="gallery__main">
      {%- if product.featured_image != blank -%}
        <img
          data-gallery-main
          src="{{ current_variant.featured_image | default: product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="{{ product.featured_image.width }}"
          height="{{ product.featured_image.height }}"
          loading="eager">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    {%- if product.images.size > 1 -%}
      <div class="gallery__thumbs gallery__thumbs--b">
        {%- for image in product.images limit: 4 offset: 1 -%}
          <button type="button" data-gallery-thumb data-full="{{ image | image_url: width: 1200 }}" aria-label="Ver imagen {{ forloop.index }}">
            <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | escape }}" width="150" height="150" loading="lazy">
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="buy">
    {%- if product.type != blank -%}
      <span class="kicker">{{ product.type }}</span>
    {%- endif -%}

    <h1>{{ product.title }}</h1>

    <div class="price{% if current_variant.compare_at_price > current_variant.price %} price--sale{% endif %}">
      {%- if current_variant.compare_at_price > current_variant.price -%}
        <s>{{ current_variant.compare_at_price | money }}</s>
      {%- endif -%}
      <span data-price>{{ current_variant.price | money }}</span>
    </div>

    {%- assign e1 = product.metafields.ovl.dominant_emotion -%}
    {%- assign e2 = product.metafields.ovl.emotional_benefit -%}
    {%- if e1 != blank or e2 != blank -%}
      <div class="badge-row">
        {%- if e1 != blank -%}<span class="badge-pill">{{ e1 }}</span>{%- endif -%}
        {%- if e2 != blank -%}<span class="badge-pill">{{ e2 }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.highlights != blank -%}
      <p class="muted">{{ section.settings.highlights }}</p>
    {%- endif -%}

    {% form 'product', product, data-product-form: 'true' %}
      {%- unless product.has_only_default_variant -%}
        {%- if color_option_index > -1 -%}
          <div class="swatch-label">Color</div>
          <div class="swatches" role="radiogroup" aria-label="Color">
            {%- for variant in product.variants -%}
              {%- liquid
                assign color_name = variant.options[color_option_index] | downcase
                case color_name
                  when 'crema' or 'beige' or 'cream'
                    assign hex = '#F3ECE1'
                  when 'terracota' or 'brown' or 'marron'
                    assign hex = '#8A5A3B'
                  when 'carbón' or 'carbon' or 'black' or 'negro'
                    assign hex = '#2B2621'
                  when 'blue' or 'azul'
                    assign hex = '#5B7C99'
                  when 'pink' or 'rosa'
                    assign hex = '#D89AA6'
                  when 'grey' or 'gray' or 'gris'
                    assign hex = '#A9A29A'
                  when 'green' or 'verde'
                    assign hex = '#6B8E63'
                  when 'red' or 'rojo'
                    assign hex = '#A6493D'
                  when 'white' or 'blanco'
                    assign hex = '#FBF8F3'
                  else
                    assign hex = '#E7DFD2'
                endcase
              -%}
              <label class="swatch{% if variant.id == current_variant.id %} swatch--active{% endif %}" style="background:{{ hex }}" title="{{ variant.options[color_option_index] }}">
                <input type="radio" name="variant_selector" value="{{ variant.id }}" data-variant-option {% if variant.id == current_variant.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %} class="visually-hidden">
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="options" role="radiogroup" aria-label="{{ 'products.variants' | t }}">
            {%- for variant in product.variants -%}
              <label class="option{% if variant.id == current_variant.id %} active{% endif %}">
                <input type="radio" name="variant_selector" value="{{ variant.id }}" data-variant-option {% if variant.id == current_variant.id %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
                {{ variant.title }}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endunless -%}

      <input type="hidden" name="id" value="{{ current_variant.id }}">

      <button
        type="submit"
        class="add"
        data-add-btn
        data-adding="{{ 'products.adding' | t }}"
        data-added="{{ 'products.added' | t }}"
        {% unless current_variant.available %}disabled{% endunless %}>
        {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }} — {{ current_variant.price | money }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
      </button>
    {% endform %}

    <div class="trust trust--center">
      {%- if section.settings.delivery_note != blank -%}<span>{{ section.settings.delivery_note }}</span>{%- endif -%}
      {%- if section.settings.returns_note != blank -%}<span> · {{ section.settings.returns_note }}</span>{%- endif -%}
    </div>
  </div>
</section>

{%- if section.settings.banner_text != blank -%}
<div class="product-banner">
  <p>{{ section.settings.banner_text }}</p>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Producto — Compra rápida",
  "settings": [
    { "type": "text", "id": "highlights", "label": "Bullets / destacados", "default": "Ventilación amplia · cierre seguro · asa ergonómica · superficie lavable" },
    { "type": "text", "id": "delivery_note", "label": "Nota de entrega", "default": "Envío en 3-5 días" },
    { "type": "text", "id": "returns_note", "label": "Nota de devolución", "default": "Devoluciones en 30 días" },
    { "type": "text", "id": "banner_text", "label": "Frase banner (opcional, itálica, debajo de compra)" }
  ]
}
{% endschema %}
