<section class="hb-rail" aria-labelledby="shop-window-heading-{{ section.id }}">
  <div class="container">
    <div class="hb-rail__head">
      <div>
        <span class="kicker hb-kicker--dark">{{ 'home.shop_window.kicker' | t }}</span>
        <h2 id="shop-window-heading-{{ section.id }}">{{ 'home.shop_window.heading' | t }}</h2>
      </div>
      {%- assign source_collection = section.settings.collection -%}
      {%- if source_collection == blank -%}
        {%- assign source_collection = collections['all'] -%}
      {%- endif -%}
      <a href="{{ source_collection.url | default: routes.all_products_collection_url }}">
        {{ 'home.shop_window.view_all' | t }} ↗
      </a>
    </div>

    {%- if source_collection != blank and source_collection.products_count > 0 -%}
      <div class="hb-rail__scroll">
        {%- for product in source_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p>{{ 'home.shop_window.empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial shop window",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Editorial shop window"
    }
  ]
}
{% endschema %}
