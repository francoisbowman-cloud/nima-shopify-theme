<section class="container search-shell">
  <div class="search-head">
    <div class="search-head__copy">
      <span class="kicker">{{ 'general.search' | t }}</span>
      <h1>{{ 'general.search' | t }}</h1>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchInput-{{ section.id }}">{{ 'general.search' | t }}</label>
      <input
        id="SearchInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search_placeholder' | t }}"
        autocomplete="off">
      <button type="submit" class="btn">{{ 'general.search' | t }}</button>
    </form>
  </div>

  {%- if search.performed -%}
    {%- if search.results.size > 0 -%}
      <p class="search-results-meta">{{ 'general.results_count' | t: count: search.results.size, terms: search.terms }}</p>
      <div class="product-grid product-grid--b search-results">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <a class="pcard" href="{{ item.url }}">
              <div class="pcard__body"><h3>{{ item.title }}</h3></div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">{{ 'general.no_results' | t: terms: search.terms }}</div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
