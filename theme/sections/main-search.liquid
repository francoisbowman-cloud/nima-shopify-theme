<section class="container search-page">
  <div class="search-page__intro">
    <h1 class="search-page__title">{{ 'general.search' | t }}</h1>
    <p class="search-page__copy">{{ 'seo.search_description' | t }}</p>
  </div>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <input
      class="search-form__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search_placeholder' | t }}"
      aria-label="{{ 'general.search' | t }}">
    <button type="submit" class="btn">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results.size > 0 -%}
      <p class="search-results-meta">{{ 'general.results_count' | t: count: search.results.size, terms: search.terms }}</p>
      <div class="product-grid product-grid--b">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {% render 'product-card', product: item %}
          {%- else -%}
            <a class="pcard" href="{{ item.url }}"><div class="pcard__body"><h3>{{ item.title }}</h3></div></a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state">{{ 'general.no_results' | t: terms: search.terms }}</div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Búsqueda", "settings": [] }
{% endschema %}
