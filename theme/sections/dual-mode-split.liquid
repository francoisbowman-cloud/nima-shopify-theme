<section class="split split--b">
  <div class="split--b__frame">
    <div class="split--b__side split--b__side--light">
      <div class="split--b__step">01 / UTILITY</div>
      {%- if section.settings.left_image != blank -%}
        {%- assign left_alt = section.settings.left_image.alt | default: section.settings.left_heading | strip_html -%}
        {{
          section.settings.left_image
          | image_url: width: 1200
          | image_tag:
            widths: '480, 720, 900, 1200',
            sizes: '(min-width: 801px) 50vw, 100vw',
            loading: 'lazy',
            decoding: 'async',
            class: 'split--b__img',
            alt: left_alt
        }}
      {%- endif -%}
      <span class="kicker">{{ section.settings.left_kicker }}</span>
      <h2 class="split--b__h">{{ section.settings.left_heading }}</h2>
      <p class="muted">{{ section.settings.left_text }}</p>
      {%- if section.settings.left_button_label != blank -%}
        <a class="btn" href="{{ section.settings.left_button_url | default: '#' }}">{{ section.settings.left_button_label }}</a>
      {%- endif -%}
    </div>
    <div class="split--b__divider"></div>
    <div class="split--b__side split--b__side--dark">
      {%- if section.settings.right_image != blank -%}
        {%- assign right_alt = section.settings.right_image.alt | default: section.settings.right_heading | strip_html -%}
        {{
          section.settings.right_image
          | image_url: width: 1400
          | image_tag:
            widths: '480, 720, 960, 1200, 1400',
            sizes: '(min-width: 801px) 50vw, 100vw',
            loading: 'lazy',
            decoding: 'async',
            class: 'split--b__bgimg',
            alt: right_alt
        }}
      {%- endif -%}
      <div class="split--b__scrim"></div>
      <div class="split--b__content">
        <div class="split--b__step split--b__step--light">02 / EDITORIAL</div>
        <span class="kicker on-dark-kicker">{{ section.settings.right_kicker }}</span>
        <h2 class="split--b__h on-dark-heading">{{ section.settings.right_heading }}</h2>
        <p class="on-dark-text" style="max-width:340px">{{ section.settings.right_text }}</p>
        {%- if section.settings.right_button_label != blank -%}
          <a class="btn btn--light" href="{{ section.settings.right_button_url | default: '#' }}">{{ section.settings.right_button_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="split--b__connector"><span>→</span></div>
  </div>
</section>

{% schema %}
{
  "name": "Split Comprar / Descubrir",
  "settings": [
    { "type": "header", "content": "Lado Comprar (Utility)" },
    { "type": "image_picker", "id": "left_image", "label": "Imagen" },
    { "type": "text", "id": "left_kicker", "label": "Kicker", "default": "Utility Commerce" },
    { "type": "text", "id": "left_heading", "label": "Título", "default": "Todo lo esencial, sin vueltas." },
    { "type": "textarea", "id": "left_text", "label": "Texto", "default": "Catálogo curado de comederos, descanso y grooming — con envío rápido y devoluciones simples." },
    { "type": "text", "id": "left_button_label", "label": "Texto del botón", "default": "Ir al catálogo" },
    { "type": "url", "id": "left_button_url", "label": "Enlace del botón" },
    { "type": "header", "content": "Lado Descubrir (Editorial)" },
    { "type": "image_picker", "id": "right_image", "label": "Imagen" },
    { "type": "text", "id": "right_kicker", "label": "Kicker", "default": "Editorial Commerce" },
    { "type": "text", "id": "right_heading", "label": "Título", "default": "Historias de cuidado diario." },
    { "type": "textarea", "id": "right_text", "label": "Texto", "default": "Magazine: rituales, texturas y la filosofía detrás de cada objeto que elegimos vender." },
    { "type": "text", "id": "right_button_label", "label": "Texto del botón", "default": "Leer el Magazine" },
    { "type": "url", "id": "right_button_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Split Comprar / Descubrir" }]
}
{% endschema %}
