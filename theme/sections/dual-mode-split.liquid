<section class="premium-story container">
  <div class="premium-story__copy">
    <span class="kicker">{{ 'home.story.kicker' | t }}</span>
    <h2>{{ 'home.story.heading' | t }}</h2>
    <p>{{ 'home.story.text' | t }}</p>
    <a class="premium-story__link" href="{{ section.settings.left_button_url | default: routes.all_products_collection_url }}">{{ 'home.story.cta' | t }}</a>
  </div>
  <div class="premium-story__media">
    {%- assign story_image = section.settings.right_image | default: section.settings.left_image -%}
    {%- if story_image != blank -%}
      {{
        story_image
        | image_url: width: 1600
        | image_tag:
          widths: '640, 960, 1200, 1600',
          sizes: '(min-width: 801px) 58vw, 100vw',
          loading: 'lazy',
          decoding: 'async',
          alt: story_image.alt | default: 'home.story.heading' | t
      }}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Premium story",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Imagen alternativa" },
    { "type": "image_picker", "id": "right_image", "label": "Imagen principal" },
    { "type": "url", "id": "left_button_url", "label": "Enlace" }
  ],
  "presets": [{ "name": "Premium story" }]
}
{% endschema %}