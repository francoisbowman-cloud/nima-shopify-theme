<section class="split">
  <div>
    <span class="kicker">{{ section.settings.left_kicker }}</span>
    <h2 class="big">{{ section.settings.left_heading }}</h2>
    <p class="muted">{{ section.settings.left_text }}</p>
    {%- if section.settings.left_button_label != blank -%}
      <a class="btn" href="{{ section.settings.left_button_url | default: '#' }}">{{ section.settings.left_button_label }} →</a>
    {%- endif -%}
  </div>
  <div class="dark">
    <span class="kicker">{{ section.settings.right_kicker }}</span>
    <h2 class="big">{{ section.settings.right_heading }}</h2>
    <p>{{ section.settings.right_text }}</p>
    {%- if section.settings.right_button_label != blank -%}
      <a class="btn btn--light" href="{{ section.settings.right_button_url | default: '#' }}">{{ section.settings.right_button_label }} →</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Split Comprar / Descubrir",
  "settings": [
    { "type": "header", "content": "Lado Comprar (Utility)" },
    { "type": "text", "id": "left_kicker", "label": "Kicker", "default": "Utility Commerce" },
    { "type": "text", "id": "left_heading", "label": "Título", "default": "Cuando ya sabes lo que necesitas." },
    { "type": "textarea", "id": "left_text", "label": "Texto", "default": "Categorías claras, filtros útiles, información esencial y compra inmediata." },
    { "type": "text", "id": "left_button_label", "label": "Texto del botón", "default": "Ir a comprar" },
    { "type": "url", "id": "left_button_url", "label": "Enlace del botón" },
    { "type": "header", "content": "Lado Descubrir (Editorial)" },
    { "type": "text", "id": "right_kicker", "label": "Kicker", "default": "Editorial Commerce" },
    { "type": "text", "id": "right_heading", "label": "Título", "default": "Cuando quieres entender antes de elegir." },
    { "type": "textarea", "id": "right_text", "label": "Texto", "default": "Historias, contextos, comparativas y productos integrados en una narrativa." },
    { "type": "text", "id": "right_button_label", "label": "Texto del botón", "default": "Entrar al Journal" },
    { "type": "url", "id": "right_button_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Split Comprar / Descubrir" }]
}
{% endschema %}
