{%- liquid
  assign story_heading = 'home.story.heading' | t
  assign story_alt = section.settings.right_image.alt | default: section.settings.left_image.alt
  if story_alt == blank
    assign story_alt = story_heading
  endif
-%}
<section class="hb-story container">
  <div class="hb-story__grid">
    <div class="hb-story__media">
      {%- assign story_image = section.settings.right_image | default: section.settings.left_image -%}
      {%- if story_image != blank -%}
        {{
          story_image
          | image_url: width: 1200
          | image_tag:
            widths: '480, 720, 960, 1200',
            sizes: '(min-width: 801px) 45vw, 100vw',
            loading: 'lazy',
            decoding: 'async',
            alt: story_alt
        }}
      {%- endif -%}
    </div>
    <div class="hb-story__copy">
      <span class="kicker">{{ 'home.story.kicker' | t }}</span>
      <h2>{{ story_heading }}</h2>
      <p>{{ 'home.story.text' | t }}</p>
      <a class="btn" href="{{ section.settings.left_button_url | default: routes.all_products_collection_url }}">{{ 'home.story.cta' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium story",
  "settings": [
    { "type": "image_picker", "id": "left_image", "label": "Imagen alternativa" },
    { "type": "image_picker", "id": "right_image", "label": "Imagen principal" },
    { "type": "url", "id": "left_button_url", "label": "Enlace" }
  ],
  "presets": [{ "name": "Premium story" }]
}
{% endschema %}
