{%- liquid
  assign feature_kicker = section.settings.feature_kicker
  assign feature_heading = section.settings.feature_heading
  assign feature_text = section.settings.feature_text
  assign feature_button = section.settings.feature_button_label
  if section.settings.use_localized_copy
    assign feature_kicker = 'sections.magazine.feature_kicker' | t
    assign feature_heading = 'sections.magazine.feature_heading' | t
    assign feature_text = 'sections.magazine.feature_text' | t
    assign feature_button = 'sections.magazine.feature_button' | t
  endif
-%}
<section class="container mag-grid" aria-labelledby="MagazineFeature-{{ section.id }}">
  <article class="feature{% if section.settings.feature_image != blank %} feature--image{% endif %}">
    {%- if section.settings.feature_image != blank -%}
      {%- assign feature_alt = section.settings.feature_image.alt | default: feature_heading | strip_html -%}
      {{
        section.settings.feature_image
        | image_url: width: 1400
        | image_tag:
          widths: '480, 720, 960, 1200, 1400',
          sizes: '(min-width: 801px) 58vw, 100vw',
          loading: 'lazy',
          decoding: 'async',
          class: 'feature__media',
          alt: feature_alt
      }}
    {%- else -%}
      <img class="feature__media" src="{{ 'nima-magazine-grooming.webp' | asset_url }}" width="1120" height="1400" loading="lazy" decoding="async" alt="{{ feature_heading | escape }}">
    {%- endif -%}
    <span class="mag-media-scrim" aria-hidden="true"></span>
    <div class="feature__content">
      <span class="kicker">{{ feature_kicker }}</span>
      <h2 id="MagazineFeature-{{ section.id }}">{{ feature_heading }}</h2>
      <p>{{ feature_text }}</p>
      {%- if feature_button != blank and section.settings.feature_button_url != blank -%}
        <a class="btn" href="{{ section.settings.feature_button_url }}">{{ feature_button }}</a>
      {%- endif -%}
    </div>
  </article>

  <aside aria-label="{{ 'blogs.journal' | t }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign story_kicker = block.settings.kicker
        assign story_heading = block.settings.heading
        assign story_text = block.settings.text
        if section.settings.use_localized_copy and forloop.index <= 3
          assign story_key_base = 'sections.magazine.story_' | append: forloop.index
          assign story_kicker_key = story_key_base | append: '_kicker'
          assign story_heading_key = story_key_base | append: '_heading'
          assign story_text_key = story_key_base | append: '_text'
          assign story_kicker = story_kicker_key | t
          assign story_heading = story_heading_key | t
          assign story_text = story_text_key | t
        endif
      -%}
      <article class="side-story{% if block.settings.url != blank %} side-story--linked{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" aria-label="{{ story_heading | escape }}">{%- endif -%}
          <span class="kicker">{{ story_kicker }}</span>
          <h3>{{ story_heading }}</h3>
          <p class="muted">{{ story_text }}</p>
          {%- if block.settings.url != blank -%}<span class="side-story__arrow" aria-hidden="true">↗</span>{%- endif -%}
        {%- if block.settings.url != blank -%}</a>{%- endif -%}
      </article>
    {%- endfor -%}
  </aside>
</section>

{% schema %}
{
  "name": "Magazine — Grid",
  "settings": [
    { "type": "checkbox", "id": "use_localized_copy", "label": "Usar copy automático EN/ES", "default": true },
    { "type": "header", "content": "Historia principal" },
    { "type": "text", "id": "feature_kicker", "label": "Kicker", "default": "Historia principal" },
    { "type": "textarea", "id": "feature_heading", "label": "Título", "default": "El primer viaje no empieza en el coche." },
    { "type": "textarea", "id": "feature_text", "label": "Texto", "default": "Empieza cuando tu mascota entiende que ese espacio también puede ser seguro." },
    { "type": "text", "id": "feature_button_label", "label": "Texto del botón", "default": "Leer y preparar el viaje" },
    { "type": "url", "id": "feature_button_url", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "feature_image", "label": "Imagen de fondo (opcional)" }
  ],
  "blocks": [
    {
      "type": "side_story",
      "name": "Nota lateral",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Guía" },
        { "type": "text", "id": "heading", "label": "Título", "default": "Cómo elegir una transportadora sin adivinar." },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Tamaño, ventilación, material y comportamiento." },
        { "type": "url", "id": "url", "label": "Enlace" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Magazine — Grid",
      "blocks": [
        { "type": "side_story", "settings": { "kicker": "Guía", "heading": "Cómo elegir una transportadora sin adivinar.", "text": "Tamaño, ventilación, material y comportamiento." } },
        { "type": "side_story", "settings": { "kicker": "Checklist", "heading": "7 cosas antes de salir.", "text": "Una lista simple para evitar estrés innecesario." } },
        { "type": "side_story", "settings": { "kicker": "Selección", "heading": "El kit de viaje tranquilo.", "text": "Transportadora, bebedero y manta calmante." } }
      ]
    }
  ]
}
{% endschema %}
