<section class="container" style="padding:60px 0 80px">
  <span class="kicker">{{ 'blogs.journal' | t }}</span>
  <h1 style="font-family:var(--serif);font-size:clamp(48px,7vw,110px);line-height:.92;margin:6px 0 40px">{{ blog.title }}</h1>
  <div class="mag-grid mag-grid--blog">
    {%- for article in blog.articles -%}
      <article class="feature feature--blog{% if article.image %} feature--image{% endif %}">
        {%- if article.image -%}
          {%- assign article_alt = article.image.alt | default: article.title -%}
          {{
            article.image
            | image_url: width: 1200
            | image_tag:
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 801px) 50vw, 100vw',
              loading: 'lazy',
              decoding: 'async',
              class: 'feature__media',
              alt: article_alt
          }}
          <span class="mag-media-scrim" aria-hidden="true"></span>
        {%- endif -%}
        <div class="feature__content">
          <span class="kicker">{{ article.published_at | date: '%d %b %Y' }}</span>
          <h2 style="font-size:34px;margin:8px 0 12px"><a href="{{ article.url }}">{{ article.title }}</a></h2>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          <a class="btn{% if article.image %} btn--light{% endif %}" href="{{ article.url }}">{{ 'blogs.read' | t }} →</a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
