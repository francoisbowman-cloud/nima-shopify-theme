{%- liquid
  assign e1 = product.metafields.ovl.dominant_emotion
  assign e2 = product.metafields.ovl.emotional_benefit
-%}

<section class="container story story--b">
  {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}

  <div class="story-grid story-grid--b">
    <div>
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | default: product.title | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy">
      {%- elsif product.images[1] != blank -%}
        <img src="{{ product.images[1] | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="{{ product.images[1].width }}" height="{{ product.images[1].height }}" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <span class="kicker">Experiencia OVL</span>
      <h3 class="story--b__h">{{ section.settings.subheading }}</h3>
      <div class="rte">{{ section.settings.body }}</div>

      {%- if e1 != blank or e2 != blank -%}
        <div class="ovl-badges">
          {%- assign all_emotions = "Tranquilidad,Seguridad,Confort,Ternura,Frescura,Cuidado" | split: "," -%}
          {%- for emo in all_emotions -%}
            {%- if emo == e1 or emo == e2 -%}
              <span class="ovl-badge ovl-badge--active">{{ emo }}</span>
            {%- else -%}
              <span class="ovl-badge">{{ emo }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }} →</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Experiencia OVL",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Experiencia OVL" },
    { "type": "image_picker", "id": "image", "label": "Imagen (si vacío, usa la 2ª imagen del producto)" },
    { "type": "text", "id": "subheading", "label": "Título", "default": "Un objeto convertido en experiencia." },
    { "type": "richtext", "id": "body", "label": "Cuerpo", "default": "<p>OVL organiza la luz, el ritmo, la composición y el lenguaje alrededor de una emoción dominante. El producto sigue siendo fácil de comprar; la historia empieza después, para quien quiere comprender más.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Producto — Experiencia OVL" }]
}
{% endschema %}
