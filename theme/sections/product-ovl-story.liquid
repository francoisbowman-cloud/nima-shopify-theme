{%- liquid
  assign emotion = product.metafields.ovl.emotional_benefit
  assign dominant = product.metafields.ovl.dominant_emotion
  assign profile = product.metafields.ovl.visual_profile
-%}

<section class="container story">
  {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
  <h2>{{ section.settings.heading }}</h2>

  <div class="story-grid">
    <div>
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          alt="{{ section.settings.image.alt | default: product.title | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy">
      {%- elsif product.images[1] != blank -%}
        <img src="{{ product.images[1] | image_url: width: 1200 }}" alt="{{ product.title | escape }}" width="{{ product.images[1].width }}" height="{{ product.images[1].height }}" loading="lazy">
      {%- endif -%}
    </div>
    <div>
      <h3 style="font-size:40px">{{ section.settings.subheading }}</h3>

      {%- if dominant != blank or emotion != blank or profile != blank -%}
        <div class="ovl-badges">
          {%- if dominant != blank -%}<span class="ovl-badge">{{ dominant }}</span>{%- endif -%}
          {%- if emotion != blank -%}<span class="ovl-badge">{{ emotion }}</span>{%- endif -%}
          {%- if profile != blank -%}<span class="ovl-badge">{{ profile }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      <div class="rte">{{ section.settings.body }}</div>

      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }} →</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Experiencia OVL",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Descubre por qué fue diseñada así" },
    { "type": "textarea", "id": "heading", "label": "Título grande", "default": "La tranquilidad no se añade al final. Se construye desde el primer detalle." },
    { "type": "image_picker", "id": "image", "label": "Imagen (si vacío, usa la 2ª imagen del producto)" },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Un objeto convertido en experiencia." },
    { "type": "richtext", "id": "body", "label": "Cuerpo", "default": "<p>OVL organiza la luz, el ritmo, la composición y el lenguaje alrededor de una emoción dominante. El producto sigue siendo fácil de comprar; la historia empieza después, para quien quiere comprender más.</p>" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Leer la historia" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Producto — Experiencia OVL" }]
}
{% endschema %}
