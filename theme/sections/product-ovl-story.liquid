{%- liquid
  assign e1 = product.metafields.ovl.dominant_emotion
  assign e2 = product.metafields.ovl.emotional_benefit
-%}
<section class="container story story--b">
  <span class="kicker">{{ 'products.story.kicker' | t }}</span>
  <div class="story-grid story-grid--b">
    <div>
      {%- if section.settings.image != blank -%}
        {%- assign story_alt = section.settings.image.alt | default: product.title -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 801px) 48vw, 100vw', loading: 'lazy', decoding: 'async', alt: story_alt }}
      {%- elsif product.images[1] != blank -%}
        {{ product.images[1] | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 801px) 48vw, 100vw', loading: 'lazy', decoding: 'async', alt: product.title }}
      {%- endif -%}
    </div>
    <div>
      <h3 class="story--b__h">{{ 'products.story.heading' | t }}</h3>
      <p class="rte">{{ 'products.story.body' | t }}</p>
      {%- if e1 != blank or e2 != blank -%}
        <div class="ovl-badges">
          {%- assign all_emotions = "Tranquilidad,Seguridad,Confort,Ternura,Frescura,Cuidado" | split: "," -%}
          {%- for emo in all_emotions -%}
            {%- capture public_emotion -%}{% render 'public-emotion-label', emotion: emo %}{%- endcapture -%}
            {%- if public_emotion != blank -%}<span class="ovl-badge{% if emo == e1 or emo == e2 %} ovl-badge--active{% endif %}">{{ public_emotion | strip }}</span>{%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Historia de producto",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen (si vacío, usa la 2ª imagen del producto)" }
  ],
  "presets": [{ "name": "Producto — Historia" }]
}
{% endschema %}