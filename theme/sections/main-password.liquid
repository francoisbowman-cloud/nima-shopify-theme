<section class="container empty-state" style="min-height:70vh;display:grid;place-content:center;text-align:center">
  <div class="logo" style="font-size:40px">{{ shop.name }}.</div>
  <p class="muted" style="max-width:420px;margin:14px auto 30px">{{ shop.password_message | default: 'Estamos preparando algo especial. Vuelve pronto.' }}</p>

  {% form 'storefront_password' %}
    {%- if form.errors -%}<p style="color:#c0392b">{{ 'general.password_error' | t }}</p>{%- endif -%}
    <input type="password" name="password" placeholder="{{ 'general.password' | t }}"
      style="padding:14px 18px;border:1px solid var(--line);border-radius:999px;font-size:16px">
    <button type="submit" class="btn">{{ 'general.enter' | t }}</button>
  {% endform %}
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
