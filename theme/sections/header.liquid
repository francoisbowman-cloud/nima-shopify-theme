<header class="container nav">
  <a class="logo" href="{{ routes.root_url }}">
    {%- if section.settings.logo != blank -%}
      <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name | escape }}" width="{{ section.settings.logo.width }}" height="{{ section.settings.logo.height }}" style="width:120px;height:auto">
    {%- else -%}
      {{ shop.name }}.
    {%- endif -%}
  </a>

  <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-label="{{ 'accessibility.menu' | t }}">
    <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
  </button>

  <nav class="navlinks" data-navlinks aria-label="{{ 'accessibility.primary_nav' | t }}">
    {%- for link in section.settings.menu.links -%}
      <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
  </nav>

  <div class="actions">
    <a href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t }}">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
    </a>
    <a href="{{ routes.account_url }}" aria-label="{{ 'accessibility.account' | t }}">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="8" r="3.25"></circle>
        <path d="M5.5 19c.7-3.3 3-5 6.5-5s5.8 1.7 6.5 5"></path>
      </svg>
    </a>
    <a class="cart-link" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
      <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M3.5 5h2l1.6 9.2h9.8l1.6-6.4H6.1"></path>
        <circle cx="9" cy="18" r="1"></circle>
        <circle cx="16" cy="18" r="1"></circle>
      </svg>
      <span class="cart-label">{{ 'general.cart' | t }}</span>
      <span class="cart-count" data-cart-count aria-live="polite" aria-atomic="true">{{ cart.item_count }}</span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Encabezado",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (opcional)"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
