<div class="container collection-head">
  <span class="kicker">{{ 'collections.shop' | t }}</span>
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <div class="rte muted">{{ collection.description }}</div>
  {%- else -%}
    <p class="muted collection-sub">{{ 'collections.default_description' | t }}</p>
  {%- endif -%}
</div>

<div class="container">
  {%- if collection.products.size > 0 -%}
    {%- assign product_types = collection.products | map: 'type' | uniq -%}
    {%- if product_types.size > 0 -%}
      <div class="filterbar" data-catalog-filter>
        <div class="filterbar__chips" role="group" aria-label="{{ 'collections.filter_by_category' | t }}">
          <button type="button" class="filterbar__chip filterbar__chip--active" data-filter-chip data-category="all" aria-pressed="true">{{ 'collections.all_category' | t }}</button>
          {%- for type in product_types -%}
            {%- unless type == blank -%}
              <button type="button" class="filterbar__chip" data-filter-chip data-category="{{ type | escape }}" aria-pressed="false">{{ type }}</button>
            {%- endunless -%}
          {%- endfor -%}
        </div>
        <div class="filterbar__meta">
          <span data-filter-count data-label="{{ 'collections.products_count' | t }}">{{ collection.products.size }} {{ 'collections.products_count' | t }}</span>
          <select class="filterbar__select" aria-label="{{ 'collections.sort_by' | t }}" onchange="location.href=this.value">
            <option value="{{ collection.url }}?sort_by=manual"{% if collection.sort_by == 'manual' or collection.sort_by == blank %} selected{% endif %}>{{ 'collections.sort_featured' | t }}</option>
            <option value="{{ collection.url }}?sort_by=price-ascending"{% if collection.sort_by == 'price-ascending' %} selected{% endif %}>{{ 'collections.sort_price_asc' | t }}</option>
            <option value="{{ collection.url }}?sort_by=price-descending"{% if collection.sort_by == 'price-descending' %} selected{% endif %}>{{ 'collections.sort_price_desc' | t }}</option>
          </select>
        </div>
      </div>
    {%- endif -%}
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="product-grid product-grid--b" data-product-grid>
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      <p class="empty-state" data-filter-empty hidden>{{ 'collections.no_filter_results' | t }}</p>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'collections.empty' | t }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Listado de colección",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
