<div class="container collection-head">
  <span class="kicker">{{ 'collections.shop' | t }}</span>
  <h1>{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <div class="rte muted">{{ collection.description }}</div>
  {%- endif -%}
</div>

<div class="container">
  {%- if collection.products.size > 0 -%}
    {%- paginate collection.products by section.settings.products_per_page -%}
      <div class="product-grid">
        {%- for product in collection.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="empty-state">
      <p>{{ 'collections.empty' | t }}</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Listado de colección",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Productos por página", "min": 8, "max": 48, "step": 4, "default": 24 }
  ]
}
{% endschema %}
