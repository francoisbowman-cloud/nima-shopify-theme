<section class="hero">
  <div class="hero-copy">
    <span class="kicker">{{ 'home.hero.kicker' | t }}</span>
    <h1>{{ 'home.hero.heading' | t }}</h1>
    <p>{{ 'home.hero.text' | t }}</p>
    <a class="btn" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ 'home.hero.cta' | t }}</a>
  </div>
  <div class="hero-art">
    {%- if section.settings.image != blank -%}
      {%- assign hero_alt = section.settings.image.alt | default: 'home.hero.heading' | t | strip_html -%}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        srcset="
          {{ section.settings.image | image_url: width: 640 }} 640w,
          {{ section.settings.image | image_url: width: 960 }} 960w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w"
        sizes="(min-width: 801px) 58vw, 100vw"
        alt="{{ hero_alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
        decoding="async">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "url", "id": "button_url", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "image", "label": "Imagen" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}