<section class="hero">
  <div class="hero-copy">
    {%- if section.settings.kicker != blank -%}<span class="kicker">{{ section.settings.kicker }}</span>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_url | default: '#' }}">{{ section.settings.button_label }} →</a>
    {%- endif -%}
  </div>
  <div class="hero-art">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bienestar para quienes más amas" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Comprar rápido. Descubrir mejor." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Una tienda con dos velocidades: resuelve en segundos o entra en historias, guías y experiencias dirigidas por OVL." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_url", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "image", "label": "Imagen" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
