{%- liquid
  assign hero_alt = section.settings.image.alt | default: 'home.hero.heading' | t | strip_html
  assign lead_product = collections['all'].products.first
-%}
<section class="hb-studio">
  <div class="hb-studio__head">
    <span class="kicker">{{ 'home.hero.kicker' | t }}</span>
    <h1>{{ 'home.hero.heading' | t }}</h1>
    <p>{{ 'home.hero.text' | t }}</p>
  </div>
  <div class="hb-studio__spread">
    <div class="hb-studio__hero">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            widths: '640, 960, 1200, 1400, 1800',
            sizes: '(min-width: 801px) 60vw, 100vw',
            loading: 'eager',
            fetchpriority: 'high',
            decoding: 'async',
            alt: hero_alt
        }}
      {%- endif -%}
    </div>
    <a class="hb-studio__lead" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">
      {%- if lead_product != blank -%}
        {%- if lead_product.featured_image != blank -%}
          {%- assign lead_alt = lead_product.featured_image.alt | default: lead_product.title -%}
          <div class="hb-studio__lead-media">
            {{
              lead_product.featured_image
              | image_url: width: 480
              | image_tag:
                widths: '240, 360, 480',
                sizes: '(min-width: 801px) 150px, 112px',
                loading: 'eager',
                decoding: 'async',
                alt: lead_alt
            }}
          </div>
        {%- endif -%}
        <div>
          <span class="kicker hb-kicker--dark">{{ 'products.bestseller' | t }}</span>
          <h3>{{ lead_product.title }}</h3>
          {%- if lead_product.type != blank -%}
            <p>{% render 'product-type-label', type: lead_product.type %}</p>
          {%- endif -%}
        </div>
        <div class="hb-price">{{ lead_product.price | money }}</div>
      {%- else -%}
        <div>
          <span class="kicker hb-kicker--dark">{{ 'home.hero.kicker' | t }}</span>
          <h3>{{ 'home.hero.heading' | t }}</h3>
        </div>
      {%- endif -%}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "url", "id": "button_url", "label": "Enlace del botón" },
    { "type": "image_picker", "id": "image", "label": "Imagen" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
