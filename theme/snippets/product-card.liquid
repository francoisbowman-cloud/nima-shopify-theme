{%- comment -%} Uso: {% render 'product-card', product: product %} {%- endcomment -%}
{%- assign is_featured = false -%}
{%- assign tag_label = '' -%}
{%- assign media_grade = 'missing' -%}
{%- assign color_values = blank -%}
{%- if product.featured_image != blank -%}
  {%- assign media_probe = product.featured_image | image_url: width: 1200 | downcase -%}
  {%- if media_probe contains '-refined-' or media_probe contains '_refined_' or media_probe contains 'refined-v' -%}
    {%- assign media_grade = 'refined' -%}
  {%- else -%}
    {%- assign media_grade = 'source' -%}
  {%- endif -%}
{%- endif -%}
{%- for option in product.options_with_values -%}
  {%- assign option_name = option.name | downcase -%}
  {%- if option_name == 'color' or option_name == 'colour' or option_name == 'color / size' -%}
    {%- assign color_values = option.values -%}
  {%- endif -%}
{%- endfor -%}
{%- if product.available == false -%}
  {%- assign tag_label = 'products.sold_out' | t -%}
{%- elsif product.tags contains 'bestseller' -%}
  {%- assign is_featured = true -%}
  {%- assign tag_label = 'products.bestseller' | t -%}
{%- elsif product.tags contains 'nuevo' -%}
  {%- assign tag_label = 'products.new' | t -%}
{%- endif -%}

<a class="pcard{% if is_featured %} pcard--featured{% endif %}" href="{{ product.url }}" data-category="{{ product.type | escape }}" data-media-grade="{{ media_grade }}">
  <div class="pcard__media" data-media-surface data-media-grade="{{ media_grade }}">
    {%- if product.featured_image != blank -%}
      {%- assign card_alt = product.featured_image.alt | default: product.title -%}
      {{
        product.featured_image
        | image_url: width: 1200
        | image_tag:
          widths: '320, 480, 640, 800, 960, 1200',
          sizes: '(max-width: 380px) 100vw, (min-width: 1000px) 25vw, (min-width: 800px) 33vw, 50vw',
          loading: 'lazy',
          decoding: 'async',
          class: 'pcard__image',
          alt: card_alt
      }}
    {%- else -%}
      <div class="pcard__placeholder" role="img" aria-label="{{ 'products.image_unavailable_for' | t: product: product.title | escape }}">
        <svg aria-hidden="true" viewBox="0 0 48 48" focusable="false">
          <rect x="7" y="9" width="34" height="30" rx="3"></rect>
          <path d="m12 33 8-8 6 6 4-4 6 6"></path>
          <circle cx="31" cy="18" r="3"></circle>
        </svg>
        <span>{{ 'products.image_unavailable' | t }}</span>
      </div>
    {%- endif -%}
    {%- if tag_label != '' -%}
      <span class="pcard__tag">{{ tag_label }}</span>
    {%- endif -%}
  </div>
  <div class="pcard__body">
    {%- if product.type != blank -%}
      <span class="pcard__category">{% render 'product-type-label', type: product.type %}</span>
    {%- endif -%}
    {%- assign ovl_emotion = product.metafields.ovl.dominant_emotion -%}
    {%- if ovl_emotion != blank -%}
      <span class="pcard__emotion">{{ ovl_emotion }}</span>
    {%- endif -%}
    <h3>{{ product.title }}</h3>
    <div class="price{% if product.compare_at_price > product.price %} price--sale{% endif %}">
      {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
      {{ product.price | money }}
    </div>
    {%- if color_values != blank -%}
      <div class="pcard__swatches" aria-hidden="true">
        {%- for value in color_values limit: 4 -%}
          {%- liquid
            assign color_name = value | downcase
            case color_name
              when 'cream' or 'crema' or 'beige'
                assign swatch_hex = '#eadfce'
              when 'brown' or 'marron' or 'marrón' or 'tan'
                assign swatch_hex = '#9b7659'
              when 'black' or 'negro'
                assign swatch_hex = '#292725'
              when 'blue' or 'azul'
                assign swatch_hex = '#70869b'
              when 'pink' or 'rosa'
                assign swatch_hex = '#d7a8ad'
              when 'grey' or 'gray' or 'gris'
                assign swatch_hex = '#aaa6a1'
              when 'green' or 'verde' or 'mint'
                assign swatch_hex = '#98b9ad'
              when 'red' or 'rojo'
                assign swatch_hex = '#9f574c'
              when 'white' or 'blanco'
                assign swatch_hex = '#f7f5f1'
              else
                assign swatch_hex = '#d7cfc5'
            endcase
          -%}
          <span class="pcard__swatch" style="--swatch:{{ swatch_hex }}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</a>
